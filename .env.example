# 复制为 .env 后填写。只有 LLM_API_KEY 必填，其余按需取消注释。
# 密钥只放这里，不要写进 configs/*.yaml。

LLM_API_KEY=

# 覆盖 configs/server.yaml 的默认模型与端点（默认 dp-1017 + 魔搭）
# LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# LLM_BASE_URL=https://api-inference.modelscope.cn/v1

# 改用云端 embedding 时（同时把 embedding.provider 改为 openai_compatible）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3

# Milvus 开启鉴权时填写
# MILVUS_TOKEN=
